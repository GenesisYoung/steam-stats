# ---- Runtime ----
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
# Number of trusted reverse proxies (Firebase Hosting + Cloud Run front end = 1-2).
TRUST_PROXY=1

# ---- Public URLs ----
# Origin of the web app (used for redirects after Steam linking and for CORS).
PUBLIC_APP_URL=http://localhost:5173
# Origin under which /api is reachable by the browser. With the Vite proxy or
# Firebase Hosting rewrites this is the same as PUBLIC_APP_URL. It is used as
# the OpenID realm and to build the return_to URL
# (<PUBLIC_API_URL>/api/steam/callback). Steam OpenID needs no pre-registration.
PUBLIC_API_URL=http://localhost:5173
# Extra comma-separated CORS origins (optional).
CORS_ORIGINS=

# ---- Firebase Admin ----
FIREBASE_PROJECT_ID=your-firebase-project-id
# Local development: path to a service-account JSON (never commit it).
# On Cloud Run leave unset; Application Default Credentials are used.
GOOGLE_APPLICATION_CREDENTIALS=
# Use the local emulators instead of real Firebase (development / tests):
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8180
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ---- Steam ----
# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# ---- Purchase import from screenshots (optional) ----
# Anthropic API key (https://console.anthropic.com). Unset = import disabled.
ANTHROPIC_API_KEY=
IMPORT_MODEL=claude-opus-5-5

# ---- Security / behaviour ----
REQUIRE_EMAIL_VERIFIED=true
# Shared secret for POST /internal/cron/sync (Cloud Scheduler). Leave empty to disable.
CRON_SECRET=
# Max games whose achievements / prices are synced per job (remaining continue next sync).
SYNC_ACHIEVEMENT_BATCH=200
SYNC_METADATA_BATCH=150
