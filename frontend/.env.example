# Firebase Web SDK config (Project settings → General → Your apps → Web app).
# These values are public identifiers, not secrets; access is enforced by
# Firebase Auth, Firestore Security Rules and the backend.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=

# Use the local Auth emulator (development only).
VITE_USE_EMULATORS=false
VITE_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# Base path of the backend API. Keep "/api" when using the Vite proxy or
# Firebase Hosting rewrites (recommended, same-origin).
VITE_API_BASE=/api
