{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "emulators",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["firebase", "emulators:start", "--only", "auth,firestore", "--project", "demo-steam-analytics", "--config", "firebase/firebase.json"],
      "port": 4000
    },
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:backend"],
      "port": 8080
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:frontend"],
      "port": 5173
    }
  ]
}
